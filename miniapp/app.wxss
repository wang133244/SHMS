page { background:#f5f7f8; color:#172033; font-size:28rpx; }
.page { padding:28rpx; }.card { background:#fff; margin:18rpx 0; padding:24rpx; border-radius:8rpx; }.title { font-size:38rpx; font-weight:700; }.muted { color:#64748b; font-size:25rpx; }.primary { background:#0f766e; color:#fff; margin:18rpx 0; }.warning { color:#b45309; }.row { display:flex; justify-content:space-between; align-items:center; }.input { width:auto; box-sizing:border-box; background:#f8fafc; padding:18rpx; margin:16rpx 0; border-radius:6rpx; }.section-title { font-weight:700; margin:20rpx 0 10rpx; }.submission { border-top:1px solid #e5e7eb; padding:16rpx 0; }
