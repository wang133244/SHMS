<view class="page"><view class="title">我的任务</view><view class="muted">仅显示当前账号负责的任务</view><view class="card" wx:for="{{tasks}}" wx:key="id" bindtap="openTask" data-id="{{item.id}}"><view class="row"><text>{{item.title}}</text><text class="warning">{{item.status}}</text></view><view class="muted">应办日期：{{item.due_date}}</view></view><view class="card muted" wx:if="{{!tasks.length&&!error}}">今天没有应办任务</view><view class="card warning" wx:if="{{error}}">{{error}}</view></view>
